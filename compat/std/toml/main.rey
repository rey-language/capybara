// A small TOML reader for common configuration values.
// Section keys are represented as dotted keys, such as "server.port".
//
// The native Rey compiler cannot pass dynamic values (any) through a
// HashMap at runtime. Capybara only needs string values, so this copy keeps
// every parsed value as a string. Use getInt/getBool for conversions.

func trim(s: string): string {
    return s.trim();
}

func stripComment(line: string): string {
    var inQuotes = false;
    var escaped = false;
    var i = 0;
    loop {
        if i >= line.len() { break; }
        var c = line[i];
        if inQuotes {
            if escaped {
                escaped = false;
            } else if c == '\\' {
                escaped = true;
            } else if c == '"' {
                inQuotes = false;
            }
        } else if c == '"' {
            inQuotes = true;
        } else if c == '#' {
            return line.slice(0, i);
        }
        i = i + 1;
    }
    return line;
}

func findUnquotedEquals(line: string): int {
    var inQuotes = false;
    var escaped = false;
    var i = 0;
    loop {
        if i >= line.len() { break; }
        var c = line[i];
        if inQuotes {
            if escaped {
                escaped = false;
            } else if c == '\\' {
                escaped = true;
            } else if c == '"' {
                inQuotes = false;
            }
        } else if c == '"' {
            inQuotes = true;
        } else if c == '=' {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func decodeString(value: string): string {
    var result = "";
    var i = 1;
    var end = value.len() - 1;
    loop {
        if i >= end { break; }
        var c = value[i];
        if c == '\\' && i + 1 < end {
            var next = value[i + 1];
            if next == 'n' {
                result = result + "\n";
            } else if next == 'r' {
                result = result + "\r";
            } else if next == 't' {
                result = result + "\t";
            } else if next == '"' || next == '\\' {
                result = result + next.toString();
            } else {
                result = result + "\\" + next.toString();
            }
            i = i + 2;
        } else {
            result = result + c.toString();
            i = i + 1;
        }
    }
    return result;
}

func parseValue(value: string): string {
    var s = trim(value);
    if s.len() >= 2 && s[0] == '"' && s[s.len() - 1] == '"' {
        return decodeString(s);
    }
    return s;
}

pub func parse(text: string): HashMap<string, string> {
    var table: HashMap<string, string> = HashMap.new();
    var section = "";
    var lines = text.split("\n");
    var i = 0;
    loop {
        if i >= lines.len() { break; }
        var line = trim(stripComment(lines[i]));
        if line.len() > 0 {
            if line[0] == '[' && line[line.len() - 1] == ']' {
                section = trim(line.slice(1, line.len() - 1));
            } else {
                var equals = findUnquotedEquals(line);
                if equals >= 0 {
                    var key = trim(line.slice(0, equals));
                    var fullKey = key;
                    if section.len() > 0 { fullKey = section + "." + key; }
                    table.set(fullKey, parseValue(line.slice(equals + 1, line.len())));
                }
            }
        }
        i = i + 1;
    }
    return table;
}

pub func getString(table: HashMap<string, string>, key: string, defaultVal: string): string {
    if !table.has(key) { return defaultVal; }
    return table.get(key);
}

pub func getInt(table: HashMap<string, string>, key: string, defaultVal: int): int {
    if !table.has(key) { return defaultVal; }
    var value = table.get(key);
    if value.len() == 0 { return defaultVal; }
    var first = value[0];
    if first != '-' && first != '+' && (first < '0' || first > '9') {
        return defaultVal;
    }
    return value.toInt();
}

pub func getBool(table: HashMap<string, string>, key: string, defaultVal: bool): bool {
    if !table.has(key) { return defaultVal; }
    var value = table.get(key);
    if value == "true" { return true; }
    if value == "false" { return false; }
    return defaultVal;
}

func escapeString(value: string): string {
    var out = "";
    var i = 0;
    loop {
        if i >= value.len() { break; }
        var c = value[i];
        if c == '"' {
            out = out + "\\\"";
        } else if c == '\\' {
            out = out + "\\\\";
        } else if c == '\n' {
            out = out + "\\n";
        } else if c == '\r' {
            out = out + "\\r";
        } else if c == '\t' {
            out = out + "\\t";
        } else {
            out = out + c.toString();
        }
        i = i + 1;
    }
    return out;
}

func serializeValue(value: string): string {
    return "\"" + escapeString(value) + "\"";
}

pub func stringify(table: HashMap<string, string>): string {
    var out = "";
    var keys = table.keys();
    var i = 0;
    loop {
        if i >= keys.len() { break; }
        if i > 0 { out = out + "\n"; }
        var key = keys[i];
        out = out + key + " = " + serializeValue(table.get(key));
        i = i + 1;
    }
    return out;
}
